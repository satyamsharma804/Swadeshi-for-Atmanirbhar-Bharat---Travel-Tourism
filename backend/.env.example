# Server Configuration
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# MongoDB Connection
# For local: mongodb://localhost:27017/tour_planner
# For Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tour_planner
MONGODB_URI=mongodb://localhost:27017/tour_planner

# Email Service (Nodemailer)
# If left empty, system operates in dev mode (logs emails to console)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

